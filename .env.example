# Sao chép thành file `.env` và điền giá trị. Không commit `.env`.

# =1: khởi động không gọi zca-js (chỉ Web UI + DB sạch, thử trên Windows không cần cookie)
# ZALO_GUARDIAN_SKIP_ZALO=

# Đường dẫn file credentials Zalo (cookie OpenClaw / zalouser…)
ZALO_CREDENTIALS_PATH=

# Đường dẫn module zca-js (file dist/index.js)
ZCA_JS_PATH=

# Tuỳ chọn — ID bot (tham chiếu)
BOT_USER_ID=

# Admin Zalo nhận DM cảnh báo
DM_ADMIN_ID=

# Telegram — BotFather token & chat id nhận chứng minh vi phạm
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web UI — Basic Auth (khuyến nghị khi truy cập qua Tailscale/LAN). Để trống = không bật.
WEBUI_BASIC_USER=
WEBUI_BASIC_PASSWORD=
